{
  "name": "good-gh-cli",
  "version": "0.6.0-beta.1",
  "description": "A modern Git and GitHub CLI: pull requests, issues, CI, stacked branches, and zero-key AI, in one tool.",
  "type": "module",
  "main": "src/index.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonathanRReed/Good-GH-CLI.git"
  },
  "bugs": {
    "url": "https://github.com/JonathanRReed/Good-GH-CLI/issues"
  },
  "homepage": "https://github.com/JonathanRReed/Good-GH-CLI#readme",
  "keywords": [
    "git",
    "github",
    "cli",
    "gh",
    "pull-request",
    "stacked-prs",
    "worktree",
    "code-review",
    "ai",
    "developer-tools",
    "bun"
  ],
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.0.0"
  },
  "bin": {
    "ggh": "./bin/ggh.cjs",
    "good-gh": "./bin/ggh.cjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "skills/ggh",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "bun run bin/ggh.ts",
    "build": "bun build bin/ggh.ts --target=bun --outdir=dist --minify",
    "prepublishOnly": "bun run typecheck && bun run lint && bun test --timeout 30000 && bun run build",
    "test": "bun test --timeout 30000",
    "lint": "eslint src/ tests/ bin/ scripts/ bench/agent/",
    "typecheck": "bun check",
    "format": "bun fmt \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\" \"bin/**/*.{ts,js,json}\"",
    "release": "bun run scripts/release.ts",
    "compile": "bun build bin/ggh.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --minify --outfile ggh",
    "package:macos": "bun run scripts/package-macos.ts",
    "man": "bun run scripts/man.ts",
    "skill:reference": "bun run scripts/gen-skill-reference.ts",
    "test:audit": "python3 scripts/audit-regressions.py",
    "bench:agent": "bun run bench/agent/benchmark.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "execa": "^10.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.25.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
